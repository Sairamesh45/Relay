APP_NAME=Unified AI Gateway
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://gateway_user:gateway_password@localhost:5432/gateway_db

REDIS_URL=redis://localhost:6379/0
# Require Redis for distributed rate limiting in production.
RATE_LIMIT_REDIS_REQUIRED=false
RATE_LIMIT_REDIS_KEY_PREFIX=relay:rate-limit

LOG_LEVEL=INFO

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

POSTGRES_DB=gateway_db
POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=change_this_password

# Supabase (Optional for cloud database integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider Integration & Credential Vault Configuration (Phase 2)
# 32-byte encryption key for AES-256-GCM (64 hex characters or 32 raw/base64 bytes).
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_ENCRYPTION_KEY=your-32-byte-encryption-key-hex-placeholder

# Timeout for outbound provider HTTP requests in seconds
PROVIDER_REQUEST_TIMEOUT=30.0
PROVIDER_CONNECT_TIMEOUT=5.0
PROVIDER_MAX_CONNECTIONS=200
PROVIDER_MAX_KEEPALIVE_CONNECTIONS=50

# Development-only authentication boundary (MUST be false in production)
ENABLE_DEV_AUTH=false

# Virtual API Key & Gateway Configuration (Phase 4)
# HMAC-SHA256 secret key used to hash virtual API keys before storage
VIRTUAL_KEY_HMAC_SECRET=your-virtual-key-hmac-secret-min-32-chars
# Default requests-per-minute rate limit per virtual API key
GATEWAY_RATE_LIMIT_RPM=60

# Authentication & JWT Configuration
# Cryptographically secure 256-bit secret key for HMAC-SHA256 JWT signing
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

# Google OAuth Credentials (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
