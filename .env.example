# Application
PROJECT_NAME="Unified AI Gateway"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=unified_ai_gateway
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Security
SECRET_KEY="replace-with-a-secure-secret-key-in-production"
